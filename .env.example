APP_NAME=AtlasSynapse
# development | production — production requires HTTP_API_TOKEN, ADMIN_API_TOKEN,
# and non-default DATABASE_URL credentials.
APP_ENV=development
LOG_LEVEL=INFO

# Compose postgres defaults (override before any shared/staging use).
POSTGRES_DB=semantic_memory
POSTGRES_USER=semantic_memory
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://semantic_memory:change-me@localhost:5432/semantic_memory
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
RAW_PAYLOAD_RETENTION=redacted
SEMANTIC_REVIEW_MODE=disabled
EMBEDDING_MODE=disabled
MCP_TRANSPORT=stdio
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# Shared bearer / X-API-Token for all non-health HTTP routes.
# Required when APP_ENV=production. Optional in development (fail-open when empty).
HTTP_API_TOKEN=dev-api-token

# Required for POST /v1/actors/ensure. Empty/unset fails closed.
ADMIN_API_TOKEN=dev-admin-token

DEFAULT_ACTOR_CAPABILITIES=["knowledge.read","knowledge.write","ontology.read","ontology.propose"]
