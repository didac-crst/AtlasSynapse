APP_NAME=AtlasSynapse
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://semantic_memory:semantic_memory@localhost:5432/semantic_memory
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
RAW_PAYLOAD_RETENTION=redacted
SEMANTIC_REVIEW_MODE=disabled
MCP_TRANSPORT=stdio
HTTP_HOST=0.0.0.0
HTTP_PORT=8000
# Required for POST /v1/actors/ensure. Empty/unset fails closed.
ADMIN_API_TOKEN=dev-admin-token
DEFAULT_ACTOR_CAPABILITIES=["knowledge.read","knowledge.write","ontology.read","ontology.propose"]
